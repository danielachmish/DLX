# העתיקו ל-.env ומלאו. לא לשמור את הקובץ ב-git.
DLX_DOMAIN=pos.example.co.il
# סיסמאות ארוכות ואקראיות: openssl rand -base64 32
POSTGRES_PASSWORD=
DLX_OWNER_PASSWORD=
DLX_APP_PASSWORD=
JWT_SECRET=
# להצפנת הגיבויים — לשמור גם במקום בטוח מחוץ לשרת. בלעדיה אי אפשר לשחזר!
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=35
# ריק עד רישום התוכנה ברשות המסים. כל עוד ריק — רק מצב פיילוט
DLX_SOFTWARE_REGISTRATION=
DLX_VENDOR_VAT_ID=
# אופציונלי: התראות שגיאה (Slack / Teams webhook)
ERROR_WEBHOOK_URL=
