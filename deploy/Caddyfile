# DLX — שרת ווב: HTTPS אוטומטי (Let's Encrypt) לדומיין ב-DLX_DOMAIN
{$DLX_DOMAIN:localhost} {
	encode zstd gzip

	handle /v1/* {
		reverse_proxy api:8787
	}
	handle /health {
		reverse_proxy api:8787
	}

	handle {
		root * /srv
		# הקבצים עם hash בשם — שנה במטמון; index.html ו-sw.js תמיד טריים (עדכון גרסה מגיע מיד)
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh path /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(self), geolocation=(), microphone=()"
		-Server
	}
}
