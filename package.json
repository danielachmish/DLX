{
  "name": "dlx",
  "private": true,
  "version": "0.1.0",
  "description": "DLX — מערכת ניהול חנות: קופה, מלאי, רכש ומסמכים חשבונאיים",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm --filter @dlx/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @dlx/core test && pnpm --filter @dlx/api test",
    "dev:api": "pnpm --filter @dlx/api dev",
    "dev:web": "pnpm --filter @dlx/web dev",
    "db:setup": "bash scripts/db-setup.sh",
    "db:migrate": "pnpm --filter @dlx/api migrate",
    "db:seed": "pnpm --filter @dlx/api seed"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@types/node": "22.20.5"
  }
}
